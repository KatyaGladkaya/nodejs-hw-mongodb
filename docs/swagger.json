{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "<Контакти>",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "<Книга контактів>"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    },
    {
      "url": "https://nodejs-hw-mongodb-2-63e8.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "Контакти",
      "description": "Операції з контактами"
    }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "tags": [
          "Контакти"
        ],
        "summary": "Отримати всі контакти",
        "operationId": "getAllContacts",
        "description": "Повертає список контактів з пагінацією та сортуванням",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Номер сторінки (для пагінації)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "description": "Кількість контактів на сторінці",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "description": "Поле для сортування (наприклад, name або email)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "email",
                "phone",
                "createdAt"
              ]
            }
          },
          {
            "name": "sortOrder",
            "in": "query",
            "description": "Напрямок сортування",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список контактів",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully found contacts!"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ContactInput"
                      }
                    },
                    "page": {
                      "type": "integer",
                      "nullable": true,
                      "example": 1
                    },
                    "perPage": {
                      "type": "integer",
                      "nullable": true,
                      "example": 10
                    },
                    "totalItems": {
                      "type": "integer",
                      "example": 25
                    },
                    "totalPages": {
                      "type": "integer",
                      "nullable": true,
                      "example": 3
                    },
                    "hasPreviousPage": {
                      "type": "boolean",
                      "example": false
                    },
                    "hasNextPage": {
                      "type": "boolean",
                      "example": false
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Невалідний ідентифікатор контакту",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 400
                    },
                    "message": {
                      "type": "string",
                      "example": "Something went wrong"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Контакти"
        ],
        "summary": "Створити новий контакт",
        "operationId": "createContact",
        "description": "Додає новий контакт до списку.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Ivan Petrenko"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "ivan@example.com"
                  },
                  "phoneNumber": {
                    "type": "string",
                    "example": 380931112233
                  },
                  "contactType": {
                    "type": "string",
                    "example": "business"
                  },
                  "isFavourite": {
                    "type": "boolean",
                    "example": false
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "name",
                  "phoneNumber",
                  "contactType"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Контакт успішно створено",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 201
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully created a contact!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/ContactInput"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Контакт не додано",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 400
                    },
                    "message": {
                      "type": "string",
                      "example": "Something went wrong"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/contacts/{contactId}": {
      "get": {
        "tags": [
          "Контакти"
        ],
        "summary": "Отримати контакт за ID",
        "operationId": "getContactById",
        "description": "Повертає контакт за унікальним ідентифікатором.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Унікальний ідентифікатор контакту"
          }
        ],
        "responses": {
          "200": {
            "description": "Успішне отримання контакту",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully found contact with id 68797448c9f85366e1df6187!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/ContactInput"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Невалідний ідентифікатор контакту",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 400
                    },
                    "message": {
                      "type": "string",
                      "example": "Something went wrong"
                    },
                    "data": {
                      "type": "string",
                      "example": "id is not a valid"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Контакти"
        ],
        "summary": "Оновити контакт",
        "operationId": "updateContact",
        "description": "Оновлює дані існуючого контакту.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Ідентифікатор контакту"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Ivan Petrenko"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "phoneNumber": {
                    "type": "string"
                  },
                  "contactType": {
                    "type": "string"
                  },
                  "isFavourite": {
                    "type": "boolean",
                    "example": false
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успішне оновлення контакту",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully patched a contact!"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "contact": {
                          "$ref": "#/components/schemas/ContactInput"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Неправильний запит",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 400
                    },
                    "message": {
                      "type": "string",
                      "example": "Something went wrong"
                    },
                    "data": {
                      "type": "string",
                      "example": "id is not a valid"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Контакти"
        ],
        "summary": "Видалити контакт",
        "operationId": "deleteContact",
        "description": "Видаляє контакт із бази даних.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Ідентифікатор контакту"
          }
        ],
        "responses": {
          "200": {
            "description": "Контакт успішно видалено",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Contact deleted successfully"
                    },
                    "data": {
                      "type": "object",
                      "example": {}
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Контакт не видалено",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 400
                    },
                    "message": {
                      "type": "string",
                      "example": "Something went wrong"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ContactInput": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "68795d3f254db0ee2b9ded32"
          },
          "name": {
            "type": "string",
            "example": "Ivan Petrenko"
          },
          "email": {
            "type": "string",
            "example": "ivan@example.com"
          },
          "phoneNumber": {
            "type": "string",
            "example": "+380931112233"
          },
          "contactType": {
            "type": "string",
            "example": "business"
          },
          "isFavourite": {
            "type": "boolean",
            "example": false
          },
          "photo": {
            "type": "string",
            "nullable": true,
            "example": "https://example.com/photo.jpg"
          },
          "userId": {
            "type": "string",
            "example": "68795bb3254db0ee2b9ded17"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-07-17T20:29:51.016Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-07-17T20:29:51.016Z"
          },
          "__v": {
            "type": "integer",
            "example": 0
          }
        },
        "required": [
          "name",
          "email",
          "phoneNumber"
        ]
      }
    }
  }
}